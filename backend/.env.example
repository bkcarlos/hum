# ── Apple Music Developer Token (M0/M1) ─────────────────────────────
# From your Apple Developer account. The .p8 private key is signed with
# ES256 to mint a Developer Token (JWT). NEVER commit the .p8 or .env.
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=KEY1234567
# Provide the .p8 private key ONE of two ways:
#  (a) local/dev: a file path
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_KEY1234567.p8
#  (b) cloud hosts: paste the PEM contents into APPLE_PRIVATE_KEY (multi-line, or
#      a single line with literal \n escapes). Takes precedence over the path.
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n"
# Developer Token lifetime (Apple max is ~6 months). Default 24h — the token is
# served to any browser, so a short life keeps the leak window small; the frontend
# (musickit.ts) re-fetches it before expiry. Raise only if you have a reason to.
APPLE_TOKEN_TTL_HOURS=24

# Apple Music API base host (override only for testing or a regional proxy).
APPLE_API_BASE=https://api.music.apple.com

# ── Server ──────────────────────────────────────────────────────────
PORT=8080
# Comma-separated origins allowed by CORS (the Vite dev server, prod host).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Gin mode: release (default) or debug. Leave unset for release.
# GIN_MODE=debug
# Single-service (方案 1): serve the built frontend from this dir. Unset in dev
# (Vite serves the SPA). The Docker image sets WEB_DIR=/app/web automatically.
# WEB_DIR=/app/web

# ── Outbound HTTP (LLM + Apple Music) ───────────────────────────────
# Per-call timeout in seconds for upstream LLM / Apple Music requests.
UPSTREAM_TIMEOUT_SECONDS=30
# Catalog search result cache lifetime in seconds (0 disables caching).
SEARCH_CACHE_TTL_SECONDS=600
# Trusted "appending" proxies in front of the app (for per-IP rate limiting + logs).
# 0 = none (the direct peer is the client; local dev). Cloud Run: set 1 — Google's
# front end appends the real client IP as the LAST X-Forwarded-For entry.
# TRUSTED_PROXY_HOPS=1

# NOTE: There is intentionally NO LLM API key here. User LLM keys are
# BYOK — they arrive per-request in the X-LLM-Api-Key header, are used
# once, and are never persisted, cached, or logged (see F0 / scheme B).
